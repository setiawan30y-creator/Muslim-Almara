APP_NAME="ALMARA MUSLIM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://muslim-almara.test
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=almara_muslim
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- ALMARA MUSLIM ---
# Kota bawaan (slug dari resources/data/kota.json); admin dapat mengubahnya di panel
ALMARA_DEFAULT_CITY=jakarta
# Metode jadwal sholat bawaan: kemenag|mwl|umm-al-qura|egypt|isna|karachi|jakim|muis
ALMARA_PRAYER_METHOD=kemenag
# Koreksi tanggal Hijriah (hari, -2..2) bila berbeda dengan penetapan resmi
HIJRI_ADJUSTMENT=0
# Edisi Mushaf penuh berlisensi (kosongkan sampai aset terverifikasi tersedia)
ALMARA_MUSHAF_EDITION=

# --- Audio qari ---
# Qari ALMARA (rekaman sendiri): diunggah lewat Admin → Audio qari, disimpan di disk privat
ALMARA_AUDIO_DISK=local
ALMARA_AUDIO_MAX_MB=150
ALMARA_AUDIO_MAX_MINUTES=240
# Qari berlisensi Quran.Foundation — daftar di https://api-docs.quran.foundation (Developer Console)
# Wajib atribusi "Quran data provided by Quran.Foundation"; cache maks. 1 minggu (aplikasi memakai 1 hari)
QF_ENABLED=false
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# production | prelive (prelive hanya berisi surah 1-2)
QF_ENV=production
# --- Terjemah teks (opsional, layanan kompatibel LibreTranslate) ---
# Kosongkan bila tidak dipakai; halaman Terjemah tetap berisi kumpulan frasa
TRANSLATE_URL=
TRANSLATE_API_KEY=
# --- Cuaca (Open-Meteo) ---
# API gratis hanya untuk non-komersial. Aplikasi disewakan/berbayar/beriklan: isi OPEN_METEO_API_KEY (paket berlangganan)
ALMARA_WEATHER=true
OPEN_METEO_API_KEY=
# --- Masjid terdekat (OpenStreetMap Overpass, tanpa kunci) ---
OVERPASS_URL=https://overpass-api.de/api/interpreter

# true = mode simulasi untuk mencoba pemutar tanpa kredensial (nada uji, bukan bacaan)
QF_MOCK=false

# Domain yang memakai sesi untuk API /api/v1 (APP_URL otomatis ikut)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,muslim-almara.test
